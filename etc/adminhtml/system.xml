<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>

        <section id="reactedge"
                 translate="label"
                 sortOrder="900"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">

            <label>ReactEdge</label>
            <tab>general</tab>
            <resource>ReactEdge_Integration::config</resource>

            <!-- ===================== -->
            <!-- USP                   -->
            <!-- ===================== -->
            <group id="usp"
                   translate="label"
                   sortOrder="20"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="20">

                <label>USP Widget</label>

                <field id="enabled" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable USP</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- ===================== -->
            <!-- MEGA MENU             -->
            <!-- ===================== -->
            <group id="megamenu"
                   translate="label"
                   sortOrder="60"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Mega Menu Widget</label>

                <field id="enabled" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Mega Menu</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- ===================== -->
            <!-- PRODUCT GALLERY      -->
            <!-- ===================== -->
            <group id="productgallery"
                   translate="label"
                   sortOrder="100"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Product Gallery Widget</label>

                <field id="enabled" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Product Gallery</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- ===================== -->
            <!-- INTENT DISCOVERY      -->
            <!-- ===================== -->
            <group id="intentdiscovery"
                   translate="label"
                   sortOrder="100"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Intent Discovery Widget</label>

                <field id="enabled" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Intent Discovery</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="intent_api_url" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Intent API URL</label>
                    <comment>Base URL used by the Intent Discovery widget.</comment>

                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- ===================== -->
            <!-- SUBRESOURCE INTEGRITY -->
            <!-- ===================== -->
            <group id="sri"
                   translate="label"
                   sortOrder="15"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Subresource Integrity</label>

                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable SRI</label>
                    <comment>Add integrity metadata when loading published ReactEdge assets.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>

            <!-- ===================== -->
            <!-- WIDGET SSR            -->
            <!-- ===================== -->
            <group id="widgets_ssr"
                   translate="label"
                   sortOrder="90"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Widget Server-Side Rendering</label>

                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable Widget SSR</label>
                    <comment>Use the ReactEdge SSR service when rendering supported widgets.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="base_url"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>SSR Base URL</label>
                    <comment>Base URL of the ReactEdge SSR service (for example: http://localhost:4000).</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <validate>required-entry validate-url</validate>
                </field>
            </group>

            <!-- ===================== -->
            <!-- OBSERVABILITY         -->
            <!-- ===================== -->
            <group id="observability"
                   translate="label"
                   sortOrder="95"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Observability</label>

                <field id="enabled"
                       translate="label comment"
                       type="select"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Enable Observability</label>
                    <comment>Enable telemetry collection for ReactEdge widget activity.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="collector_endpoint"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>OpenTelemetry Collector Endpoint</label>
                    <comment>Endpoint used to export ReactEdge telemetry.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <validate>required-entry validate-url</validate>
                </field>

                <field id="service_name"
                       translate="label comment"
                       type="text"
                       sortOrder="20"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">
                    <label>Service Name</label>
                    <comment>Service name used to identify the ReactEdge runtime in telemetry.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                    <validate>required-entry</validate>
                </field>
            </group>
        </section>

    </system>

</config>
