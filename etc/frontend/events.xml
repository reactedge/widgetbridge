<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <event name="layout_load_before">
        <observer
                name="reactedge_add_productgallery_layout_handle"
                instance="ReactEdge\WidgetBridge\Observer\AddProductGalleryLayoutHandle"
        />

        <observer
                name="reactedge_add_megamenu_layout_handle"
                instance="ReactEdge\WidgetBridge\Observer\AddMegamenuLayoutHandle"
        />
    </event>

</config>